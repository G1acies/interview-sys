# ================================
# 必需配置
# ================================

# 阿里云百炼 AI (DashScope) - LLM 服务
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# ================================
# 可选配置 - LLM 模型
# ================================

AI_MODEL=qwen3.5-flash

# ================================
# 可选配置 - 数据库与中间件
# 与 docker-compose.dev.yml 对齐
# ================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_learn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 兼容存储（MinIO / RustFS）
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=rustfsadmin
APP_STORAGE_SECRET_KEY=rustfsadmin
APP_STORAGE_BUCKET=interview-guide

# ================================
# 可选配置 - 面试参数
# ================================

APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8
